 {
  "id": "vi-9nov-01",
  "lang": "vi",
  "text": "Làm sao nói",
  "file": "vi-9nov-01.m4a",
  "from": "9 Nov 上課"
 },
 {
  "id": "vi-9nov-02",
  "lang": "vi",
  "text": "Sửa",
  "file": "vi-9nov-02.m4a",
  "from": "9 Nov 上課"
 },
 {
  "id": "vi-9nov-03",
  "lang": "vi",
  "text": "Câu",
  "file": "vi-9nov-03.m4a",
  "from": "9 Nov 上課"
 },
 {
  "id": "vi-9nov-04",
  "lang": "vi",
  "text": "Câu trước",
  "file": "vi-9nov-04.m4a",
  "from": "9 Nov 上課"
 },
 {
  "id": "vi-9nov-05",
  "lang": "vi",
  "text": "Câu này",
  "file": "vi-9nov-05.m4a",
  "from": "9 Nov 上課"
 },
 {
  "id": "vi-9nov-06",
  "lang": "vi",
  "text": "Câu đó",
  "file": "vi-9nov-06.m4a",
  "from": "9 Nov 上課"
 },
 {
  "id": "vi-9nov-07",
  "lang": "vi",
  "text": "Câu tiếp theo",
  "file": "vi-9nov-07.m4a",
  "from": "9 Nov 上課"
 },
 {
  "id": "vi-9nov-08",
  "lang": "vi",
  "text": "Dự báo thời tiết",
  "file": "vi-9nov-08.m4a",
  "from": "9 Nov 上課"
 },
 {
  "id": "vi-9nov-09",
  "lang": "vi",
  "text": "Mũi Né",
  "file": "vi-9nov-09.m4a",
  "from": "9 Nov 上課"
 },
 {
  "id": "vi-9nov-10",
  "lang": "vi",
  "text": "Lướt sóng dù",
  "file": "vi-9nov-10.m4a",
  "from": "9 Nov 上課"
 },
 {
  "id": "vi-9nov-11",
  "lang": "vi",
  "text": "Nên",
  "file": "vi-9nov-11.m4a",
  "from": "9 Nov 上課"
 },
 {
  "id": "vi-9nov-12",
  "lang": "vi",
  "text": "Trước Tết",
  "file": "vi-9nov-12.m4a",
  "from": "9 Nov 上課"
 },
 {
  "id": "vi-9nov-13",
  "lang": "vi",
  "text": "Gió",
  "file": "vi-9nov-13.m4a",
  "from": "9 Nov 上課"
 },
 {
  "id": "vi-9nov-14",
  "lang": "vi",
  "text": "Nếu anh muốn học lướt sóng dù, anh nên đi trước Tết vì trước Tết trời rất gió.",
  "file": "vi-9nov-14.m4a",
  "from": "9 Nov 上課"
 },
 {
  "id": "vi-9nov-15",
  "lang": "vi",
  "text": "Tết",
  "file": "vi-9nov-15.m4a",
  "from": "9 Nov 上課"
 },
 {
  "id": "vi-9nov-16",
  "lang": "vi",
  "text": "Vài ngày",
  "file": "vi-9nov-16.m4a",
  "from": "9 Nov 上課"
 },
 {
  "id": "vi-9nov-17",
  "lang": "vi",
  "text": "Hôm nay anh làm gì ?",
  "file": "vi-9nov-17.m4a",
  "from": "9 Nov 上課"
 },
 {
  "id": "vi-9nov-18",
  "lang": "vi",
  "text": "Tưởng",
  "file": "vi-9nov-18.m4a",
  "from": "9 Nov 上課"
 },
 {
  "id": "vi-9nov-19",
  "lang": "vi",
  "text": "Thịt",
  "file": "vi-9nov-19.m4a",
  "from": "9 Nov 上課"
 },
 {
  "id": "vi-9nov-20",
  "lang": "vi",
  "text": "Thịt gà",
  "file": "vi-9nov-20.m4a",
  "from": "9 Nov 上課"
 },
 {
  "id": "vi-9nov-22",
  "lang": "vi",
  "text": "Thịt heo",
  "file": "vi-9nov-22.m4a",
  "from": "9 Nov 上課"
 },
 {
  "id": "vi-9nov-23",
  "lang": "vi",
  "text": "Nướng",
  "file": "vi-9nov-23.m4a",
  "from": "9 Nov 上課"
 },
 {
  "id": "vi-9nov-24",
  "lang": "vi",
  "text": "Bánh mì nướng",
  "file": "vi-9nov-24.m4a",
  "from": "9 Nov 上課"
 },
 {
  "id": "vi-9nov-25",
  "lang": "vi",
  "text": "Mới",
  "file": "vi-9nov-25.m4a",
  "from": "9 Nov 上課"
 },
 {
  "id": "vi-9nov-26",
  "lang": "vi",
  "text": "Anh mới ăn 2 miếng bánh mì.",
  "file": "vi-9nov-26.m4a",
  "from": "9 Nov 上課"
 },
 {
  "id": "vi-9nov-27",
  "lang": "vi",
  "text": "Miếng",
  "file": "vi-9nov-27.m4a",
  "from": "9 Nov 上課"
 },
 {
  "id": "vi-9nov-28",
  "lang": "vi",
  "text": "Lúc 6 giờ",
  "file": "vi-9nov-28.m4a",
  "from": "9 Nov 上課"
 },
 {
  "id": "vi-9nov-29",
  "lang": "vi",
  "text": "Nhà hàng",
  "file": "vi-9nov-29.m4a",
  "from": "9 Nov 上課"
 },
 {
  "id": "vi-9nov-30",
  "lang": "vi",
  "text": "Quán",
  "file": "vi-9nov-30.m4a",
  "from": "9 Nov 上課"
 },
 {
  "id": "vi-9nov-31",
  "lang": "vi",
  "text": "Hồ bơi",
  "file": "vi-9nov-31.m4a",
  "from": "9 Nov 上課"
 },
 {
  "id": "vi-9nov-32",
  "lang": "vi",
  "text": "Nhiều người",
  "file": "vi-9nov-32.m4a",
  "from": "9 Nov 上課"
 },
 {
  "id": "vi-9nov-33",
  "lang": "vi",
  "text": "Nhà hàng cũng có bán cà phê.",
  "file": "vi-9nov-33.m4a",
  "from": "9 Nov 上課"
 },
 {
  "id": "vi-9nov-34",
  "lang": "vi",
  "text": "Thẻ",
  "file": "vi-9nov-34.m4a",
  "from": "9 Nov 上課"
 },
 {
  "id": "vi-9nov-35",
  "lang": "vi",
  "text": "Anh mua thẻ 1 tháng ở đây.",
  "file": "vi-9nov-35.m4a",
  "from": "9 Nov 上課"
 },
 {
  "id": "vi-9nov-36",
  "lang": "vi",
  "text": "Khách du lịch",
  "file": "vi-9nov-36.m4a",
  "from": "9 Nov 上課"
 },
 {
  "id": "vi-9nov-37",
  "lang": "vi",
  "text": "Người nước ngoài",
  "file": "vi-9nov-37.m4a",
  "from": "9 Nov 上課"
 },
 {
  "id": "vi-9nov-38",
  "lang": "vi",
  "text": "Người tập ở đây là người nước ngoài.",
  "file": "vi-9nov-38.m4a",
  "from": "9 Nov 上課"
 },
 {
  "id": "vi-9nov-39",
  "lang": "vi",
  "text": "Thấp",
  "file": "vi-9nov-39.m4a",
  "from": "9 Nov 上課"
 },
 {
  "id": "vi-9nov-40",
  "lang": "vi",
  "text": "Thấp hơn Việt Nam",
  "file": "vi-9nov-40.m4a",
  "from": "9 Nov 上課"
 },
 {
  "id": "vi-9nov-41",
  "lang": "vi",
  "text": "Cao",
  "file": "vi-9nov-41.m4a",
  "from": "9 Nov 上課"
 },
 {
  "id": "vi-9nov-42",
  "lang": "vi",
  "text": "Đồ ăn ở Đà Lạt rất mắc.",
  "file": "vi-9nov-42.m4a",
  "from": "9 Nov 上課"
 },
 {
  "id": "vi-9nov-43",
  "lang": "vi",
  "text": "Mắc",
  "file": "vi-9nov-43.m4a",
  "from": "9 Nov 上課"
 },
 {
  "id": "vi-9nov-44",
  "lang": "vi",
  "text": "Triệu",
  "file": "vi-9nov-44.m4a",
  "from": "9 Nov 上課"
 },
 {
  "id": "vi-9nov-45",
  "lang": "vi",
  "text": "Sài Gòn",
  "file": "vi-9nov-45.m4a",
  "from": "9 Nov 上課"
 },
 {
  "id": "vi-9nov-46",
  "lang": "vi",
  "text": "Nói chuyện",
  "file": "vi-9nov-46.m4a",
  "from": "9 Nov 上課"
 },
 {
  "id": "vi-9nov-47",
  "lang": "vi",
  "text": "Bạn",
  "file": "vi-9nov-47.m4a",
  "from": "9 Nov 上課"
 },
 {
  "id": "vi-9nov-48",
  "lang": "vi",
  "text": "Anh có bạn ở Bali không?",
  "file": "vi-9nov-48.m4a",
  "from": "9 Nov 上課"
 },
 {
  "id": "vi-9nov-49",
  "lang": "vi",
  "text": "Anh không nói chuyện với ai.",
  "file": "vi-9nov-49.m4a",
  "from": "9 Nov 上課"
 },
 {
  "id": "vi-9nov-50",
  "lang": "vi",
  "text": "Hơi xa",
  "file": "vi-9nov-50.m4a",
  "from": "9 Nov 上課"
 },
 {
  "id": "vi-9nov-51",
  "lang": "vi",
  "text": "Gym này hơi xa homestay của anh.",
  "file": "vi-9nov-51.m4a",
  "from": "9 Nov 上課"
 },
 {
  "id": "vi-9nov-52",
  "lang": "vi",
  "text": "Bali lớn hơn em nghĩ.",
  "file": "vi-9nov-52.m4a",
  "from": "9 Nov 上課"
 },
 {
  "id": "vi-9nov-53",
  "lang": "vi",
  "text": "Trung tâm mua sắm",
  "file": "vi-9nov-53.m4a",
  "from": "9 Nov 上課"
 },
 {
  "id": "vi-9nov-54",
  "lang": "vi",
  "text": "Siêu thị",
  "file": "vi-9nov-54.m4a",
  "from": "9 Nov 上課"
 },
 {
  "id": "vi-9nov-56",
  "lang": "vi",
  "text": "Siêu bão",
  "file": "vi-9nov-56.m4a",
  "from": "9 Nov 上課"
 },
 {
  "id": "vi-9nov-57",
  "lang": "vi",
  "text": "Anh thường mua đồ ở siêu thị không?",
  "file": "vi-9nov-57.m4a",
  "from": "9 Nov 上課"
 },
 {
  "id": "vi-9nov-04-06",
  "lang": "vi",
  "text": "Câu trước, câu này, câu đó",
  "file": "vi-9nov-04-06.m4a",
  "from": "9 Nov 上課"
 }
]